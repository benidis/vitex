# ---------------------------------------------------------------------------
# vitex configuration. Copy to `.env` and adjust. All values are optional;
# CLI flags override anything set here.
# ---------------------------------------------------------------------------

# Which Claude backend to use: "bedrock" (default) or "anthropic".
VITEX_PROVIDER=bedrock

# --- Bedrock (default) ------------------------------------------------------
AWS_REGION=us-east-1
# REQUIRED whenever AWS is used (provider=bedrock, or transcriber=aws): the
# ~/.aws profile for all AWS calls. There is no fallback to AWS_PROFILE, env
# keys, or [default] — without it the run stops. Not needed for
# VITEX_PROVIDER=anthropic with the whisper transcriber.
VITEX_AWS_PROFILE=my-bedrock-profile

# Bedrock model id or inference-profile id. Cross-region inference profiles
# are prefixed with the region group (e.g. "us."). Adjust to a model your
# account has access to.
VITEX_MODEL=us.anthropic.claude-opus-5-5
# Reasoning effort of the main model: low | medium | high | xhigh | max.
# Defaults to high (Claude Opus 5.5's own default is medium).
# VITEX_EFFORT=high
# Vision model that rates every distinct video frame (one call per batch of 8).
# A Haiku profile keeps this cheap; defaults to VITEX_MODEL when unset.
# VITEX_TRIAGE_MODEL=us.anthropic.claude-haiku-5-5
# Optional separate (cheaper) model for the LaTeX auto-repair pass.
# Defaults to VITEX_MODEL when unset.
# VITEX_FIX_MODEL=us.anthropic.claude-sonnet-5-5

# --- Anthropic API (fallback) ----------------------------------------------
# Only used when VITEX_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# When on the anthropic provider, VITEX_MODEL (and the triage/fix models)
# should be public model ids, e.g. claude-opus-5-5

# --- Transcription ----------------------------------------------------------
# "whisper" (local faster-whisper, default) or "aws" (Amazon Transcribe).
VITEX_TRANSCRIBER=whisper
# faster-whisper model size: tiny | base | small | medium | large-v3
VITEX_WHISPER_MODEL=small
# Required only when VITEX_TRANSCRIBER=aws: an S3 bucket you can write to.
# VITEX_TRANSCRIBE_BUCKET=my-transcribe-scratch-bucket

# --- Grounding --------------------------------------------------------------
# When enabled (the default), the model grounds the tutorial in real
# articles/papers via web + arXiv research and cites them. Set to a falsy
# value (0/false/no) for a fully offline run. The CLI --ground/--no-ground
# flags override this per run.
# VITEX_GROUND=true
